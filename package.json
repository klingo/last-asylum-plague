{
    "name": "last-asylum-plague",
    "private": true,
    "version": "1.0.0",
    "description": "Static webapp (item, package and exchange-shop valuation) for Last Asylum: Plague, deployed to GitHub Pages.",
    "type": "module",
    "engines": {
        "node": ">=22.8"
    },
    "scripts": {
        "format": "prettier --write \"**/*.{js,jsx,json,css}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,json,css}\"",
        "i18n:missing": "node scripts/missing-translations.js",
        "lint": "eslint .",
        "prepare": "husky",
        "record-run": "node scripts/record-run.js",
        "sort-pack-data": "node scripts/sort-pack-data.js",
        "test": "node --test \"test/**/*.test.js\"",
        "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-include=\"webapp/src/core/**\" --test-coverage-include=\"webapp/src/ui/**\" --test-coverage-include=\"scripts/**\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/report.txt --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
        "update-last-updated": "node scripts/update-last-updated.js",
        "verify-data": "node scripts/verify-data.js",
        "webapp:dev": "vite webapp",
        "webapp:build": "vite build webapp",
        "webapp:preview": "vite preview webapp"
    },
    "dependencies": {
        "highs": "^1.15.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "ajv": "^8.20.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "vite": "^8.3.5"
    },
    "overrides": {
        "minimatch": "^11.0.5"
    }
}
