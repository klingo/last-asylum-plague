{
    "name": "last-asylum-plague",
    "private": true,
    "version": "1.0.0",
    "description": "Static webapp (item, package and exchange-shop valuation) for Last Asylum: Plague, deployed to GitHub Pages.",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"**/*.{js,jsx,json,css}\"",
        "i18n:missing": "node scripts/missing-translations.js",
        "lint": "eslint .",
        "prepare": "husky",
        "record-run": "node scripts/record-run.js",
        "sort-pack-data": "node scripts/sort-pack-data.js",
        "test": "node --test \"test/**/*.test.js\"",
        "update-last-updated": "node scripts/update-last-updated.js",
        "verify-data": "node scripts/verify-data.js",
        "webapp:dev": "vite webapp",
        "webapp:build": "vite build webapp",
        "webapp:preview": "vite preview webapp"
    },
    "dependencies": {
        "highs": "^1.15.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "ajv": "^6.15.0",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "vite": "^8.3.5"
    }
}
