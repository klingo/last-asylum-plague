        "webapp:preview": "npm run preview --prefix webapp"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/eslintrc": "^3.3.7",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.5",
        "prettier": "3.9.6"
    }
}
