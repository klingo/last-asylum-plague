{
    "name": "last-asylum-plague",
    "private": true,
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "copy-pack-data": "node scripts/copy-pack-data.js",
        "format": "prettier --write \"**/*.{js,jsx,json,css}\"",
        "lint": "eslint .",
        "prepare": "husky",
        "sort-pack-data": "node scripts/sort-pack-data.js",
        "update-last-updated": "node scripts/update-last-updated.js",
        "verify-data": "node scripts/verify-data.js",
        "webapp:install": "npm install --prefix webapp",
        "webapp:dev": "npm run copy-pack-data && npm run dev --prefix webapp",
