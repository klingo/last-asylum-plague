{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PackData",
    "description": "Schema for Last Asylum pack solver data",
    "type": "object",
    "required": ["metadata", "items", "packages", "exchange_shops", "events"],
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "$ref": "#/definitions/metadata"
        },
        "items": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/item"
            }
        },
        "packages": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/package"
            }
        },
        "exchange_shops": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/exchangeShop"
            }
        },
        "events": {
            "type": "object",
            "description": "Registry of every toggleable \"event\" a package or exchange shop can be tied to via its `event_id` (whether or not it has its own exchange shop), giving it a display name.",
            "propertyNames": {
                "$ref": "#/definitions/eventId"
            },
            "additionalProperties": {
                "$ref": "#/definitions/event"
            }
        }
    },
    "definitions": {
        "localizedString": {
            "type": "object",
            "description": "A display string translated per supported locale. \"en\" is required and non-empty; other locales may be an empty string, which means \"not yet translated\" and falls back to \"en\" wherever this is displayed.",
            "required": ["en"],
            "additionalProperties": false,
            "properties": {
                "en": {
                    "type": "string",
                    "minLength": 1
                },
                "de": {
                    "type": "string"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["game", "currency", "last_updated"],
            "additionalProperties": false,
            "properties": {
                "game": {
                    "type": "string",
                    "minLength": 1
                },
                "currency": {
                    "type": "string",
                    "enum": ["Banknotes"]
                },
                "last_updated": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            }
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "itemQuantities": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            },
            "minProperties": 1
        },
        "limitType": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly", "exclusive", "event"]
        },
        "weekday": {
            "type": "string",
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "availableDays": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/weekday"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "substitutesFor": {
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                {
                    "$ref": "#/definitions/itemQuantities"
                }
            ]
        },
        "standardItem": {
            "type": "object",
            "required": ["name", "category"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                }
            }
        },
        "choicePool": {
            "type": "object",
            "required": ["choices"],
            "additionalProperties": false,
            "properties": {
                "select_count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "choices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/itemQuantities"
                    },
                    "minItems": 2
                }
            }
        },
        "choiceItem": {
            "type": "object",
            "required": ["name", "category", "type", "choice"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "type": {
                    "type": "string",
                    "enum": ["choice"]
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                }
            }
        },
        "randomItemDrop": {
            "type": "object",
            "required": ["contains", "probability"],
            "additionalProperties": false,
            "properties": {
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "probability": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                }
            }
        },
        "randomItem": {
            "type": "object",
            "required": ["name", "category", "type", "drop_table"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "type": {
                    "type": "string",
                    "enum": ["random"]
                },
                "drop_table": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/randomItemDrop"
                    },
                    "minItems": 2
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                }
            }
        },
        "item": {
            "oneOf": [
                {
                    "$ref": "#/definitions/standardItem"
                },
                {
                    "$ref": "#/definitions/choiceItem"
                },
                {
                    "$ref": "#/definitions/randomItem"
                }
            ]
        },
        "itemCategory": {
            "type": "string",
            "enum": ["resource", "hero", "gear", "special", "speedup", "virtual", "curio"]
        },
        "package": {
            "oneOf": [
                {
                    "$ref": "#/definitions/standalonePackage"
                },
                {
                    "$ref": "#/definitions/packageFamily"
                }
            ]
        },
        "standalonePackage": {
            "type": "object",
            "description": "A single purchasable SKU with no sibling tiers. `deal_percentage` and `limit_type` are optional: some SKUs (e.g. plain diamond top-ups) have no in-game discount framing and no purchase cadence at all (paired with `purchase_limit: null`).",
            "required": ["name", "category", "price", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a repeatable weekly pass)."
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                }
            }
        },
        "packageTier": {
            "type": "object",
            "description": "One rung of a package family's price ladder. Buying this tier is assumed to require having already bought every lower-numbered tier present in the same family's `tiers` map.",
            "required": ["price", "deal_percentage", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a repeatable weekly pass)."
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                }
            }
        },
        "packageFamily": {
            "type": "object",
            "description": "A ladder of same-family packages (e.g. T1/T2 daily offers) sharing a name/category/limit_type, keyed by tier number so a not-yet-known tier can simply be left out without shifting any other tier's number.",
            "required": ["name", "category", "limit_type", "tiers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "tiers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/tierNumber"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/packageTier"
                    },
                    "minProperties": 1
                }
            }
        },
        "tierNumber": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
        },
        "packageCategory": {
            "type": "string",
            "enum": [
                "daily_offer",
                "daily_must_buy",
                "weekly_special",
                "premium_monthly_pass",
                "weekly_pass",
                "pack_shop",
                "value_event",
                "weekly_rotation",
                "shop_event",
                "unlock_exclusive",
                "special",
                "special_event",
                "diamond"
            ]
        },
        "exchangeShop": {
            "type": "object",
            "required": ["name", "currency_item_id", "offers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "currency_item_id": {
                    "$ref": "#/definitions/id"
                },
                "offers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/id"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/exchangeShopOffer"
                    }
                },
                "bonus_tiers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": { "type": "integer", "minimum": 1 }
                    }
                }
            }
        },
        "exchangeShopOffer": {
            "type": "object",
            "required": ["item_id", "currency_cost", "quantity", "purchase_limit", "limit_type"],
            "additionalProperties": false,
            "properties": {
                "item_id": {
                    "$ref": "#/definitions/id"
                },
                "currency_cost": {
                    "type": "integer",
                    "minimum": 1
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1
                },
                "purchase_limit": {
                    "type": "integer",
                    "minimum": 1
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                }
            }
        },
        "eventId": {
            "type": "string",
            "enum": ["blades_out", "strange_bazaar", "surprise_encounter", "weekly_special", "mystic_cabinet"]
        },
        "event": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                }
            }
        }
    }
}
