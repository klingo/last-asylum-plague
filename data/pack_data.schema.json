{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PackData",
    "description": "Schema for Last Asylum pack solver data",
    "type": "object",
    "required": ["metadata", "items", "packages", "exchange_shops", "events"],
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "$ref": "#/definitions/metadata"
        },
        "items": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/item"
            }
        },
        "packages": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/package"
            }
        },
        "exchange_shops": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/exchangeShop"
            }
        },
        "events": {
            "type": "object",
            "description": "Registry of every toggleable \"event\" a package or exchange shop can be tied to via its `event_id` (whether or not it has its own exchange shop), giving it a display name.",
            "propertyNames": {
                "$ref": "#/definitions/eventId"
            },
            "additionalProperties": {
                "$ref": "#/definitions/event"
            }
        },
        "spend_reward_tracks": {
            "type": "object",
            "description": "Standalone (not tied to a package or event) ladders of cumulative real-money Banknote spend during an event: reach a tier's spend threshold and get that tier's reward. Independent of `packages`/`events` on purpose.",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/spendRewardTrack"
            }
        },
        "schedule": {
            "type": "object",
            "description": "When each event (incl. in-game events), seasonal pass family and spend reward track ran: its runs as inclusive start/end dates, oldest first, recorded with `npm run record-run`. Feeds the timeline and forecast on the Home page.",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["start", "end"],
                    "properties": {
                        "start": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "First day (YYYY-MM-DD)."
                        },
                        "end": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "Last day (YYYY-MM-DD), inclusive."
                        }
                    }
                }
            }
        },
        "heroes": {
            "type": "object",
            "description": "Heroes, e.g. for squad guides.",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/hero"
            }
        },
        "gear_upgrades": {
            "type": "object",
            "description": "Gear sets and how they are upgraded.",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/gearSet"
            }
        },
        "squad_guides": {
            "type": "object",
            "description": "Squads and the ideal order to upgrade their gear (Gear Path page).",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/squadGuide"
            }
        }
    },
    "definitions": {
        "localizedString": {
            "type": "object",
            "description": "A display string translated per supported locale. \"en\" is required and non-empty; other locales may be an empty string, which means \"not yet translated\" and falls back to \"en\" wherever this is displayed.",
            "required": ["en"],
            "additionalProperties": false,
            "properties": {
                "en": {
                    "type": "string",
                    "minLength": 1
                },
                "de": {
                    "type": "string"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["game", "currency", "last_updated"],
            "additionalProperties": false,
            "properties": {
                "game": {
                    "type": "string",
                    "minLength": 1
                },
                "currency": {
                    "type": "string",
                    "enum": ["Banknotes"]
                },
                "last_updated": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            }
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "itemQuantities": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            },
            "minProperties": 1
        },
        "limitType": {
            "type": "string",
            "enum": ["daily", "weekly", "biweekly", "monthly", "lifetime", "event"],
            "description": "`biweekly` = `purchase_limit` purchases per 14 days (e.g. a 2-week pass); `lifetime` = `purchase_limit` purchases ever, never resets (hero unlocks, 3 Copper Coin packs); `event` = `purchase_limit` purchases per run of the package's event."
        },
        "weekday": {
            "type": "string",
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "availableDays": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/weekday"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "substitutesFor": {
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                {
                    "$ref": "#/definitions/itemQuantities"
                }
            ]
        },
        "standardItem": {
            "type": "object",
            "required": ["name", "category"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "rarity": {
                    "$ref": "#/definitions/rarity"
                },
                "image": {
                    "$ref": "#/definitions/id",
                    "description": "Image to show instead of the item id's own: another item's id (e.g. `ur_curio` uses `curio_chest_ur`'s image) or the name of an image in webapp/public/assets/items shared by several items (e.g. every rarity of `herb_level_supply`)."
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "reversible": {
                    "type": "boolean",
                    "description": "When true, `contains` works in both directions: the item can be broken down into its contents AND crafted back from them (e.g. 4 Leather <-> 1 Brass). Without it, `contains` only means \"opens into\"."
                },
                "crafted_from": {
                    "$ref": "#/definitions/itemQuantities",
                    "description": "Recipe: the item can be crafted from these ingredients (e.g. 800 UR Epigraph Shards -> 1 Frenzied Flock IV). Used by the planners; in the valuation it caps the item's worth at the ingredients' worth."
                }
            }
        },
        "choicePool": {
            "type": "object",
            "required": ["choices"],
            "additionalProperties": false,
            "properties": {
                "select_count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "choices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/itemQuantities"
                    },
                    "minItems": 2
                }
            }
        },
        "choiceItem": {
            "type": "object",
            "required": ["name", "category", "type", "choice"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "rarity": {
                    "$ref": "#/definitions/rarity"
                },
                "image": {
                    "$ref": "#/definitions/id",
                    "description": "Image to show instead of the item id's own: another item's id (e.g. `ur_curio` uses `curio_chest_ur`'s image) or the name of an image in webapp/public/assets/items shared by several items (e.g. every rarity of `herb_level_supply`)."
                },
                "type": {
                    "type": "string",
                    "enum": ["choice"]
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                }
            }
        },
        "randomItemDrop": {
            "type": "object",
            "required": ["contains", "probability"],
            "additionalProperties": false,
            "properties": {
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "probability": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                }
            }
        },
        "randomItem": {
            "type": "object",
            "required": ["name", "category", "type", "drop_table"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "rarity": {
                    "$ref": "#/definitions/rarity"
                },
                "image": {
                    "$ref": "#/definitions/id",
                    "description": "Image to show instead of the item id's own: another item's id (e.g. `ur_curio` uses `curio_chest_ur`'s image) or the name of an image in webapp/public/assets/items shared by several items (e.g. every rarity of `herb_level_supply`)."
                },
                "type": {
                    "type": "string",
                    "enum": ["random"]
                },
                "drop_table": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/randomItemDrop"
                    },
                    "minItems": 2
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                }
            }
        },
        "item": {
            "required": ["rarity"],
            "oneOf": [
                {
                    "$ref": "#/definitions/standardItem"
                },
                {
                    "$ref": "#/definitions/choiceItem"
                },
                {
                    "$ref": "#/definitions/randomItem"
                }
            ]
        },
        "rarity": {
            "type": ["string", "null"],
            "enum": ["mr", "ur", "ssr", "sr", "r", null],
            "description": "The item's rarity: colours the border of its image. Required; null = the neutral border (items without a rarity)."
        },
        "itemCategory": {
            "type": "string",
            "enum": [
                "speedup",
                "resource",
                "chest",
                "material",
                "gear",
                "raven",
                "consumable",
                "event_item",
                "skin_decor"
            ]
        },
        "package": {
            "oneOf": [
                {
                    "$ref": "#/definitions/standalonePackage"
                },
                {
                    "$ref": "#/definitions/packageFamily"
                }
            ]
        },
        "standalonePackage": {
            "type": "object",
            "description": "A single purchasable SKU with no sibling tiers. `deal_percentage` and `limit_type` are optional: some SKUs (e.g. plain diamond top-ups) have no in-game discount framing and no purchase cadence at all (paired with `purchase_limit: null`).",
            "required": ["name", "category", "price", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "icon": {
                    "$ref": "#/definitions/id",
                    "description": "Item whose image stands for this package (e.g. on the Home page's Weekday Offers). Default: its first item other than diamonds and the items that are Don't care by default (VIP points, alliance chests, ...)."
                },
                "image": {
                    "$ref": "#/definitions/eventImage"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a plain diamond top-up)."
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                },
                "delivery_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The rewards arrive daily over this many days; `contains` is the total over all of them. Set on every pass (7 for weekly passes, 30 for the monthly pass) and on calendar packs; a package with it and no event counts as a pass."
                },
                "exclusive_group": {
                    "$ref": "#/definitions/id",
                    "description": "Packages sharing this group are mutually exclusive: only one of them can be bought (per event run, or per week without an event), e.g. the calendar packs of an event."
                },
                "seasonal": {
                    "type": "boolean",
                    "description": "Only on sale some of the time (e.g. a seasonal pass such as the Gear Pass). Users tick whether it is on sale right now; packages without it are always available (within their limits)."
                },
                "bundles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Packages (ids, or family ids for tier ladders) this package already includes, like the Weekly Pass includes the single weekly passes. It can not be owned together with any of them: the planners buy either this package or (some of) those, never both."
                }
            }
        },
        "packageTier": {
            "type": "object",
            "description": "One rung of a package family's price ladder. Buying this tier is assumed to require having already bought every lower-numbered tier present in the same family's `tiers` map.",
            "required": ["price", "deal_percentage", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a plain diamond top-up)."
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                }
            }
        },
        "packageFamily": {
            "type": "object",
            "description": "A ladder of same-family packages (e.g. T1/T2 daily offers) sharing a name/category/limit_type, keyed by tier number so a not-yet-known tier can simply be left out without shifting any other tier's number.",
            "required": ["name", "category", "limit_type", "tiers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "icon": {
                    "$ref": "#/definitions/id",
                    "description": "Item whose image stands for this package (e.g. on the Home page's Weekday Offers). Default: its first item other than diamonds and the items that are Don't care by default (VIP points, alliance chests, ...)."
                },
                "image": {
                    "$ref": "#/definitions/eventImage"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "tiers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/tierNumber"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/packageTier"
                    },
                    "minProperties": 1
                },
                "delivery_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The rewards arrive daily over this many days; `contains` is the total over all of them. Set on every pass (7 for weekly passes, 30 for the monthly pass) and on calendar packs; a package with it and no event counts as a pass."
                },
                "exclusive_group": {
                    "$ref": "#/definitions/id",
                    "description": "Packages sharing this group are mutually exclusive: only one of them can be bought (per event run, or per week without an event), e.g. the calendar packs of an event."
                },
                "seasonal": {
                    "type": "boolean",
                    "description": "Only on sale some of the time (e.g. a seasonal pass such as the Gear Pass). Users tick whether it is on sale right now; packages without it are always available (within their limits)."
                },
                "bundles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Packages (ids, or family ids for tier ladders) this package already includes, like the Weekly Pass includes the single weekly passes. It can not be owned together with any of them: the planners buy either this package or (some of) those, never both."
                }
            }
        },
        "tierNumber": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
        },
        "packageCategory": {
            "type": "string",
            "description": "Where the package is bought in the game (the shop tab). Display only. `weekly_rotation` = the unnamed weekday offers, `unlock_exclusive` = hero unlock packs without a named place.",
            "enum": [
                "daily_offer",
                "daily_must_buy",
                "weekly_special",
                "weekly_rotation",
                "weekly_pass",
                "premium_monthly_pass",
                "value_event",
                "pack_shop",
                "special_event",
                "season_event",
                "ingame_event",
                "calendar_gift",
                "clinic_development_pack",
                "unlock_exclusive",
                "diamond"
            ]
        },
        "exchangeShop": {
            "type": "object",
            "required": ["name", "currency_item_id", "offers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "currency_item_id": {
                    "$ref": "#/definitions/id"
                },
                "random_offers": {
                    "type": "boolean",
                    "description": "Only a random selection of the offers is on sale (e.g. the Recluse Merchant): the Events page says per offer whether it is worth buying when it shows up, instead of how many to buy."
                },
                "points_per_currency": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Progress points per coin spent in this shop (default 1). `bonus_tiers` thresholds and offer `unlock_points` are in these points, e.g. Encounter Points: 5 per Surprise Emblem spent."
                },
                "point_purchase": {
                    "type": "object",
                    "required": ["currency_item_id", "currency_cost", "points"],
                    "additionalProperties": false,
                    "description": "Another way to earn progress points, bought with a currency (e.g. an Encounter: 100 diamonds = 10 points). Its own rewards are not modelled.",
                    "properties": {
                        "currency_item_id": {
                            "$ref": "#/definitions/id"
                        },
                        "currency_cost": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "points": {
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    }
                },
                "offers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/id"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/exchangeShopOffer"
                    }
                },
                "bonus_tiers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                }
            }
        },
        "exchangeShopOffer": {
            "type": "object",
            "required": ["item_id", "currency_cost", "quantity", "purchase_limit", "limit_type"],
            "additionalProperties": false,
            "properties": {
                "item_id": {
                    "$ref": "#/definitions/id"
                },
                "currency_cost": {
                    "type": "integer",
                    "minimum": 1
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1
                },
                "purchase_limit": {
                    "type": "integer",
                    "minimum": 1
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "unlock_points": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Progress points (the shop's `points_per_currency`) needed in the current run before this offer can be bought; omitted = 0."
                }
            }
        },
        "eventId": {
            "type": "string",
            "enum": [
                "blades_out",
                "strange_bazaar",
                "surprise_encounter",
                "weekly_special",
                "mystic_cabinet",
                "full_moon_night",
                "recluse_merchant",
                "claires_inner_demon",
                "pandemic_experience",
                "gear_upgrade",
                "shadow_blight",
                "hunt_battle",
                "dwarven_mine"
            ]
        },
        "event": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "image": {
                    "$ref": "#/definitions/eventImage"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "exceedable_pack_limits": {
                    "type": "boolean",
                    "description": "The event's packs can be bought beyond their purchase limit (Events page: \"Exceed event pack limits\")."
                },
                "calendar_group": {
                    "type": "string",
                    "enum": ["spend_rewards"],
                    "description": "Show the event in this group of the Calendar's schedule instead of the one its category gives. For reward ladders that count something other than Banknotes (e.g. materials used on gear) and so aren't `spend_reward_tracks`."
                }
            }
        },
        "spendRewardTrack": {
            "type": "object",
            "description": "A ladder of cumulative spend tiers. Buying this tier's reward is assumed to require having already reached every lower threshold present in the same track's `tiers` map. Without `conversions`, `tiers` is keyed by the total Banknotes spent (in this event) needed to reach that tier. With `conversions`, real-money Banknotes don't convert 1:1 into this event's own spend-tracking currency (e.g. buying a 499-Banknote pack might grant 500 tracked points) — `tiers` is then keyed by that currency's cumulative amount instead, and the Banknote cost of each tier is solved for as the cheapest combination of `conversions` purchases covering the gap.",
            "required": ["name", "tiers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "image": {
                    "$ref": "#/definitions/eventImage"
                },
                "conversions": {
                    "type": "array",
                    "description": "The purchasable Banknote denominations this event offers for earning its own spend-tracking currency, e.g. `{price: 499, points: 500}` for a 499-Banknote pack granting 500 tracked points. Assumed freely repeatable (no purchase limit) during the event.",
                    "items": {
                        "type": "object",
                        "required": ["price", "points"],
                        "additionalProperties": false,
                        "properties": {
                            "price": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "points": {
                                "type": "integer",
                                "minimum": 1
                            }
                        }
                    },
                    "minItems": 1
                },
                "tiers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/tierNumber"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/itemQuantities"
                    },
                    "minProperties": 1
                }
            }
        },
        "eventImage": {
            "$ref": "#/definitions/id",
            "description": "The game's banner for an event, spend reward track or seasonal pass: webapp/public/assets/events/<image>.webp (720×360). Shown on the Calendar, the Events page and Spend Rewards. Several entries may share one."
        },
        "heroClass": {
            "type": "string",
            "description": "A hero's class: its part in the squad.",
            "enum": ["tank", "carry", "support"]
        },
        "hero": {
            "type": "object",
            "description": "A hero.",
            "required": ["name", "rarity", "faction", "class", "image"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "rarity": {
                    "type": "string",
                    "enum": ["sr", "ssr", "ur"]
                },
                "faction": {
                    "$ref": "#/definitions/heroFaction"
                },
                "class": {
                    "$ref": "#/definitions/heroClass"
                },
                "image": {
                    "$ref": "#/definitions/id",
                    "description": "Image name in webapp/public/assets/heroes (e.g. \"ur_daskal\" for ur_daskal.png)."
                }
            }
        },
        "gearSet": {
            "type": "object",
            "description": "A set of gear pieces upgraded the same way: levels (capped by the whole stars) and stars (written 0, 0.2, …, 4, then 5 = MR; working toward a star needs a minimum level).",
            "required": ["items", "layout", "max_level", "level_cap_by_stars", "min_level_for_star"],
            "additionalProperties": false,
            "properties": {
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/definitions/id"
                    }
                },
                "layout": {
                    "type": "array",
                    "description": "Rows of the square the pieces are shown in next to a hero (top row first).",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/id"
                        }
                    }
                },
                "max_level": {
                    "type": "integer",
                    "minimum": 1
                },
                "level_cap_by_stars": {
                    "type": "object",
                    "description": "Highest level per whole stars (0–4).",
                    "propertyNames": {
                        "pattern": "^[0-5]$"
                    },
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "min_level_for_star": {
                    "type": "object",
                    "description": "Minimum level to work toward a star (1–5).",
                    "propertyNames": {
                        "pattern": "^[0-5]$"
                    },
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "blueprints": {
                    "type": "object",
                    "description": "The blueprint item a star upgrade uses: \"ur\" for the UR stars, \"mr\" for the step to 5 stars (MR).",
                    "additionalProperties": false,
                    "properties": {
                        "ur": {
                            "$ref": "#/definitions/id"
                        },
                        "mr": {
                            "$ref": "#/definitions/id"
                        }
                    }
                },
                "level_costs": {
                    "type": "object",
                    "description": "Cost of reaching a level (key), as item quantities. Optional, can be partial.",
                    "propertyNames": {
                        "pattern": "^[1-9]\\d*$"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/itemQuantities"
                    }
                },
                "star_costs": {
                    "type": "object",
                    "description": "Cost of reaching a star step (key: \"0.2\", …, \"4\", \"5\"), as item quantities. Optional.",
                    "propertyNames": {
                        "pattern": "^(0\\.[2468]|[1-3](\\.[02468])?|4|5)$"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/itemQuantities"
                    }
                }
            }
        },
        "squadGuide": {
            "type": "object",
            "description": "A squad's formation and three upgrade paths, each in its own order: crafting (piece by piece), levels and stars. The page merges them into one order that keeps their dependencies.",
            "required": ["name", "formation", "slots", "gear", "craft_path", "level_path", "star_path"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "formation": {
                    "type": "object",
                    "required": ["front", "back"],
                    "additionalProperties": false,
                    "properties": {
                        "front": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        },
                        "back": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        }
                    }
                },
                "slots": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/id"
                    },
                    "additionalProperties": {
                        "type": "object",
                        "required": ["class", "heroes"],
                        "additionalProperties": false,
                        "properties": {
                            "class": {
                                "$ref": "#/definitions/heroClass"
                            },
                            "heroes": {
                                "type": "object",
                                "description": "The slot's hero per hero faction (the Gear Path page switches between the factions; they share the paths).",
                                "minProperties": 1,
                                "propertyNames": {
                                    "$ref": "#/definitions/heroFaction"
                                },
                                "additionalProperties": {
                                    "$ref": "#/definitions/id"
                                }
                            }
                        }
                    }
                },
                "gear": {
                    "$ref": "#/definitions/id",
                    "description": "The gear set (`gear_upgrades`) the path upgrades."
                },
                "craft_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/craftStep"
                    }
                },
                "level_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/levelStep"
                    }
                },
                "star_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/starStep"
                    }
                }
            }
        },
        "craftStep": {
            "type": "object",
            "description": "Craft one gear piece for one squad slot.",
            "required": ["item", "slot"],
            "additionalProperties": false,
            "properties": {
                "item": {
                    "$ref": "#/definitions/id"
                },
                "slot": {
                    "$ref": "#/definitions/id"
                }
            }
        },
        "levelStep": {
            "type": "object",
            "description": "Bring gear pieces to at least this level (a target state). `items` / `slots` may be \"all\".",
            "required": ["level", "items", "slots"],
            "additionalProperties": false,
            "properties": {
                "level": {
                    "type": "integer",
                    "minimum": 1
                },
                "items": {
                    "oneOf": [
                        {
                            "const": "all"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        }
                    ]
                },
                "slots": {
                    "oneOf": [
                        {
                            "const": "all"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        }
                    ]
                }
            }
        },
        "starStep": {
            "type": "object",
            "description": "Bring gear pieces to at least these stars: 0.2, 0.4, …, 4 (UR, in fifths), 5 = MR. `items` / `slots` may be \"all\".",
            "required": ["stars", "items", "slots"],
            "additionalProperties": false,
            "properties": {
                "stars": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 5
                },
                "items": {
                    "oneOf": [
                        {
                            "const": "all"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        }
                    ]
                },
                "slots": {
                    "oneOf": [
                        {
                            "const": "all"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/definitions/id"
                            }
                        }
                    ]
                }
            }
        },
        "heroFaction": {
            "type": "string",
            "description": "A hero's faction.",
            "enum": ["warrior", "ranger", "warlock"]
        }
    }
}
