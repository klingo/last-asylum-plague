{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PackData",
    "description": "Schema for Last Asylum pack solver data",
    "type": "object",
    "required": ["metadata", "items", "packages", "exchange_shops", "events"],
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "$ref": "#/definitions/metadata"
        },
        "items": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/item"
            }
        },
        "packages": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/package"
            }
        },
        "exchange_shops": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/exchangeShop"
            }
        },
        "events": {
            "type": "object",
            "description": "Registry of every toggleable \"event\" a package or exchange shop can be tied to via its `event_id` (whether or not it has its own exchange shop), giving it a display name.",
            "propertyNames": {
                "$ref": "#/definitions/eventId"
            },
            "additionalProperties": {
                "$ref": "#/definitions/event"
            }
        },
        "spend_reward_tracks": {
            "type": "object",
            "description": "Standalone (not tied to a package or event) ladders of cumulative real-money Banknote spend during an event: reach a tier's spend threshold and get that tier's reward. Independent of `packages`/`events` on purpose.",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "$ref": "#/definitions/spendRewardTrack"
            }
        }
    },
    "definitions": {
        "localizedString": {
            "type": "object",
            "description": "A display string translated per supported locale. \"en\" is required and non-empty; other locales may be an empty string, which means \"not yet translated\" and falls back to \"en\" wherever this is displayed.",
            "required": ["en"],
            "additionalProperties": false,
            "properties": {
                "en": {
                    "type": "string",
                    "minLength": 1
                },
                "de": {
                    "type": "string"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["game", "currency", "last_updated"],
            "additionalProperties": false,
            "properties": {
                "game": {
                    "type": "string",
                    "minLength": 1
                },
                "currency": {
                    "type": "string",
                    "enum": ["Banknotes"]
                },
                "last_updated": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            }
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "itemQuantities": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/definitions/id"
            },
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            },
            "minProperties": 1
        },
        "limitType": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly", "exclusive", "event"]
        },
        "weekday": {
            "type": "string",
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "availableDays": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/weekday"
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "substitutesFor": {
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                {
                    "$ref": "#/definitions/itemQuantities"
                }
            ]
        },
        "standardItem": {
            "type": "object",
            "required": ["name", "category"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "reversible": {
                    "type": "boolean",
                    "description": "When true, `contains` works in both directions: the item can be broken down into its contents AND crafted back from them (e.g. 4 Leather <-> 1 Brass). Without it, `contains` only means \"opens into\"."
                },
                "crafted_from": {
                    "$ref": "#/definitions/itemQuantities",
                    "description": "Recipe: the item can be crafted from these ingredients (e.g. 9 Lv.1 Sharp Beaks -> 1 Lv.3 Sharp Beak). Used by the planners; in the valuation it caps the item's worth at the ingredients' worth."
                }
            }
        },
        "choicePool": {
            "type": "object",
            "required": ["choices"],
            "additionalProperties": false,
            "properties": {
                "select_count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "choices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/itemQuantities"
                    },
                    "minItems": 2
                }
            }
        },
        "choiceItem": {
            "type": "object",
            "required": ["name", "category", "type", "choice"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "type": {
                    "type": "string",
                    "enum": ["choice"]
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                }
            }
        },
        "randomItemDrop": {
            "type": "object",
            "required": ["contains", "probability"],
            "additionalProperties": false,
            "properties": {
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "probability": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                }
            }
        },
        "randomItem": {
            "type": "object",
            "required": ["name", "category", "type", "drop_table"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/itemCategory"
                },
                "type": {
                    "type": "string",
                    "enum": ["random"]
                },
                "drop_table": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/randomItemDrop"
                    },
                    "minItems": 2
                },
                "substitutes_for": {
                    "$ref": "#/definitions/substitutesFor"
                },
                "value_equivalent": {
                    "$ref": "#/definitions/itemQuantities"
                }
            }
        },
        "item": {
            "oneOf": [
                {
                    "$ref": "#/definitions/standardItem"
                },
                {
                    "$ref": "#/definitions/choiceItem"
                },
                {
                    "$ref": "#/definitions/randomItem"
                }
            ]
        },
        "itemCategory": {
            "type": "string",
            "enum": ["resource", "hero", "gear", "raven_gear", "special", "speedup", "virtual", "curio", "epigraph"]
        },
        "package": {
            "oneOf": [
                {
                    "$ref": "#/definitions/standalonePackage"
                },
                {
                    "$ref": "#/definitions/packageFamily"
                }
            ]
        },
        "standalonePackage": {
            "type": "object",
            "description": "A single purchasable SKU with no sibling tiers. `deal_percentage` and `limit_type` are optional: some SKUs (e.g. plain diamond top-ups) have no in-game discount framing and no purchase cadence at all (paired with `purchase_limit: null`).",
            "required": ["name", "category", "price", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a plain diamond top-up)."
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                },
                "delivery_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The rewards arrive daily over this many days; `contains` is the total over all of them. Set on every pass (7 for weekly passes, 30 for the monthly pass) and on calendar packs; a package with it and no event counts as a pass."
                },
                "exclusive_group": {
                    "$ref": "#/definitions/id",
                    "description": "Packages sharing this group are mutually exclusive: only one of them can be bought (per event run, or per week without an event), e.g. the calendar packs of an event."
                },
                "seasonal": {
                    "type": "boolean",
                    "description": "Only on sale some of the time (e.g. a seasonal pass such as the Gear Pass). Users tick whether it is on sale right now; packages without it are always available (within their limits)."
                },
                "bundles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Packages (ids, or family ids for tier ladders) this package already includes, like the Weekly Pass includes the single weekly passes. It can not be owned together with any of them: the planners buy either this package or (some of) those, never both."
                }
            }
        },
        "packageTier": {
            "type": "object",
            "description": "One rung of a package family's price ladder. Buying this tier is assumed to require having already bought every lower-numbered tier present in the same family's `tiers` map.",
            "required": ["price", "deal_percentage", "purchase_limit", "contains"],
            "additionalProperties": false,
            "properties": {
                "price": {
                    "type": "integer",
                    "minimum": 99
                },
                "deal_percentage": {
                    "type": "integer",
                    "minimum": 0
                },
                "purchase_limit": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "null means no cap on purchase count (e.g. a plain diamond top-up)."
                },
                "contains": {
                    "$ref": "#/definitions/itemQuantities"
                },
                "choice": {
                    "$ref": "#/definitions/choicePool"
                }
            }
        },
        "packageFamily": {
            "type": "object",
            "description": "A ladder of same-family packages (e.g. T1/T2 daily offers) sharing a name/category/limit_type, keyed by tier number so a not-yet-known tier can simply be left out without shifting any other tier's number.",
            "required": ["name", "category", "limit_type", "tiers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                },
                "available_days": {
                    "$ref": "#/definitions/availableDays"
                },
                "tiers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/tierNumber"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/packageTier"
                    },
                    "minProperties": 1
                },
                "delivery_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The rewards arrive daily over this many days; `contains` is the total over all of them. Set on every pass (7 for weekly passes, 30 for the monthly pass) and on calendar packs; a package with it and no event counts as a pass."
                },
                "exclusive_group": {
                    "$ref": "#/definitions/id",
                    "description": "Packages sharing this group are mutually exclusive: only one of them can be bought (per event run, or per week without an event), e.g. the calendar packs of an event."
                },
                "seasonal": {
                    "type": "boolean",
                    "description": "Only on sale some of the time (e.g. a seasonal pass such as the Gear Pass). Users tick whether it is on sale right now; packages without it are always available (within their limits)."
                },
                "bundles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Packages (ids, or family ids for tier ladders) this package already includes, like the Weekly Pass includes the single weekly passes. It can not be owned together with any of them: the planners buy either this package or (some of) those, never both."
                }
            }
        },
        "tierNumber": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
        },
        "packageCategory": {
            "type": "string",
            "description": "Where the package is bought in the game (the shop tab). Display only. `weekly_rotation` = the unnamed weekday offers, `unlock_exclusive` = hero unlock packs without a named place.",
            "enum": [
                "daily_offer",
                "daily_must_buy",
                "weekly_special",
                "weekly_rotation",
                "weekly_pass",
                "premium_monthly_pass",
                "value_event",
                "pack_shop",
                "special_event",
                "season_event",
                "calendar_gift",
                "unlock_exclusive",
                "diamond"
            ]
        },
        "exchangeShop": {
            "type": "object",
            "required": ["name", "currency_item_id", "offers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "event_id": {
                    "$ref": "#/definitions/eventId"
                },
                "currency_item_id": {
                    "$ref": "#/definitions/id"
                },
                "offers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/id"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/exchangeShopOffer"
                    }
                },
                "bonus_tiers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                }
            }
        },
        "exchangeShopOffer": {
            "type": "object",
            "required": ["item_id", "currency_cost", "quantity", "purchase_limit", "limit_type"],
            "additionalProperties": false,
            "properties": {
                "item_id": {
                    "$ref": "#/definitions/id"
                },
                "currency_cost": {
                    "type": "integer",
                    "minimum": 1
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1
                },
                "purchase_limit": {
                    "type": "integer",
                    "minimum": 1
                },
                "limit_type": {
                    "$ref": "#/definitions/limitType"
                }
            }
        },
        "eventId": {
            "type": "string",
            "enum": [
                "blades_out",
                "strange_bazaar",
                "surprise_encounter",
                "weekly_special",
                "mystic_cabinet",
                "full_moon_night",
                "recluse_merchant"
            ]
        },
        "event": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "category": {
                    "$ref": "#/definitions/packageCategory"
                }
            }
        },
        "spendRewardTrack": {
            "type": "object",
            "description": "A ladder of cumulative spend tiers. Buying this tier's reward is assumed to require having already reached every lower threshold present in the same track's `tiers` map. Without `conversions`, `tiers` is keyed by the total Banknotes spent (in this event) needed to reach that tier. With `conversions`, real-money Banknotes don't convert 1:1 into this event's own spend-tracking currency (e.g. buying a 499-Banknote pack might grant 500 tracked points) — `tiers` is then keyed by that currency's cumulative amount instead, and the Banknote cost of each tier is solved for as the cheapest combination of `conversions` purchases covering the gap.",
            "required": ["name", "tiers"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "#/definitions/localizedString"
                },
                "conversions": {
                    "type": "array",
                    "description": "The purchasable Banknote denominations this event offers for earning its own spend-tracking currency, e.g. `{price: 499, points: 500}` for a 499-Banknote pack granting 500 tracked points. Assumed freely repeatable (no purchase limit) during the event.",
                    "items": {
                        "type": "object",
                        "required": ["price", "points"],
                        "additionalProperties": false,
                        "properties": {
                            "price": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "points": {
                                "type": "integer",
                                "minimum": 1
                            }
                        }
                    },
                    "minItems": 1
                },
                "tiers": {
                    "type": "object",
                    "propertyNames": {
                        "$ref": "#/definitions/tierNumber"
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/itemQuantities"
                    },
                    "minProperties": 1
                }
            }
        }
    }
}
